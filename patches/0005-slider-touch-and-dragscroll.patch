@@ -15,6 +15,96 @@ export class ToolspaceScroller {
     private downInterval: ReturnType<typeof setInterval> | undefined;
     private upInterval: ReturnType<typeof setInterval> | undefined;
 
+    // ---- 本项目补丁 P5：手指拖拽滚动（自己实现，所以不跟面板里的滑条抢事件）----
+    private dragActive = false;
+    private dragMoved = false;
+    private dragStartY = 0;
+    private dragStartScroll = 0;
+    private lastY = 0;
+    private lastT = 0;
+    private velocity = 0;
+    private inertiaHandle: number | undefined;
+
+    /** 按在这类元素上表示"要操作控件"，不是要滚动 */
+    private isInteractive(target: EventTarget | null): boolean {
+        const el = target as HTMLElement | null;
+        if (!el || typeof el.closest !== 'function') {
+            return false;
+        }
+        return Boolean(
+            el.closest(
+                'button, input, select, textarea, a, [contenteditable], ' +
+                    '[class*="slider"], [class*="drag"], [class*="knob"], [class*="handle"]',
+            ),
+        );
+    }
+
+    private onDragStart = (e: PointerEvent): void => {
+        if (e.pointerType === 'mouse') {
+            return; // 鼠标用滚轮，不抢左键
+        }
+        if (this.isInteractive(e.target)) {
+            return; // 滑条/按钮自己处理
+        }
+        if (this.inertiaHandle !== undefined) {
+            cancelAnimationFrame(this.inertiaHandle);
+            this.inertiaHandle = undefined;
+        }
+        this.dragActive = true;
+        this.dragMoved = false;
+        this.dragStartY = e.clientY;
+        this.dragStartScroll = this.toolspace.scrollTop;
+        this.lastY = e.clientY;
+        this.lastT = performance.now();
+        this.velocity = 0;
+    };
+
+    private onDragMove = (e: PointerEvent): void => {
+        if (!this.dragActive) {
+            return;
+        }
+        const dy = e.clientY - this.dragStartY;
+        if (!this.dragMoved && Math.abs(dy) < 6) {
+            return; // 6px 内当作点击，别抢按钮
+        }
+        this.dragMoved = true;
+        this.toolspace.scrollTop = this.dragStartScroll - dy;
+        const now = performance.now();
+        const dt = Math.max(1, now - this.lastT);
+        this.velocity = (e.clientY - this.lastY) / dt; // px/ms
+        this.lastY = e.clientY;
+        this.lastT = now;
+        if (e.cancelable) {
+            e.preventDefault();
+        }
+        this.update();
+    };
+
+    private onDragEnd = (): void => {
+        if (!this.dragActive) {
+            return;
+        }
+        this.dragActive = false;
+        if (!this.dragMoved) {
+            return;
+        }
+        let v = this.velocity * 16; // px/帧
+        const step = (): void => {
+            if (Math.abs(v) < 0.5) {
+                this.inertiaHandle = undefined;
+                this.update();
+                return;
+            }
+            this.toolspace.scrollTop -= v;
+            v *= 0.94;
+            this.update();
+            this.inertiaHandle = requestAnimationFrame(step);
+        };
+        if (Math.abs(v) > 1) {
+            this.inertiaHandle = requestAnimationFrame(step);
+        }
+    };
+
     private update(): void {
         let newUpDisplay = this.upBtn.style.display;
         let newDownDisplay = this.downBtn.style.display;
@@ -133,6 +223,12 @@ export class ToolspaceScroller {
