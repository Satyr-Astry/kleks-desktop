diff --git a/src/app/script/klecks/ui/ui-scale.ts b/src/app/script/klecks/ui/ui-scale.ts
new file mode 100644
index 0000000..f0be050
--- /dev/null
+++ b/src/app/script/klecks/ui/ui-scale.ts
@@ -0,0 +1,76 @@
+import { LocalStorage } from '../../bb/base/local-storage';
+
+/**
+ * 本项目补丁 P3 —— 界面缩放（低分屏下界面元素太小 / 太挤）。
+ *
+ * 为什么只缩"外壳"：实测（Electron/Chromium 144，窗口 1424×861）
+ *   对 app 根或 body 加 zoom 时，画布后备尺寸与显示尺寸会脱钩：
+ *   zoom=1.5 → 画布后备仍是 1153，但渲染宽变成 1730，而窗口只有 1424
+ *   → 画布被拉模糊 + 右边被切掉。所以画布必须保持原生 1:1。
+ *
+ * 做法：
+ *   1) 用 CSS zoom 放大界面外壳（工具栏 / 对话框 / 状态浮层）；
+ *   2) 同时把 kl-app 的 toolWidth 按同一比例放大（见 kl-app.ts 的 getter），
+ *      否则外壳变大而画布预留空间不变 → 工具栏会压住画布。
+ */
+
+const LS_KEY = 'kl-ui-scale';
+export const UI_SCALE_MIN = 0.75;
+export const UI_SCALE_MAX = 2;
+export const UI_SCALE_STEP = 0.125;
+
+/** 需要跟着缩放的界面外壳（画布/视口不在其列） */
+const CHROME_SELECTORS = ['.kl-toolspace', '.kl-d-modal-root', '.top-overlay', '.kl-select-custom-options'];
+
+const STYLE_ID = 'kl-ui-scale-style';
+
+let current = normalize(parseFloat(LocalStorage.getItem(LS_KEY) ?? '1'));
+const listeners: Array<(scale: number) => void> = [];
+
+function normalize(value: number): number {
+    if (!Number.isFinite(value)) {
+        return 1;
+    }
+    const stepped = Math.round(value / UI_SCALE_STEP) * UI_SCALE_STEP;
+    return Math.min(UI_SCALE_MAX, Math.max(UI_SCALE_MIN, Math.round(stepped * 1000) / 1000));
+}
+
+export function getUiScale(): number {
+    return current;
+}
+
+export function applyUiScale(): void {
+    let styleEl = document.getElementById(STYLE_ID) as HTMLStyleElement | null;
+    if (!styleEl) {
+        if (!document.head) {
+            return;
+        }
+        styleEl = document.createElement('style');
+        styleEl.id = STYLE_ID;
+        document.head.append(styleEl);
+    }
+    styleEl.textContent = CHROME_SELECTORS.map((sel) => `${sel} { zoom: ${current}; }`).join('\n');
+}
+
+export function setUiScale(value: number): void {
+    const next = normalize(value);
+    if (next === current) {
+        return;
+    }
+    current = next;
+    LocalStorage.setItem(LS_KEY, String(next));
+    applyUiScale();
+    listeners.forEach((fn) => fn(next));
+}
+
+export function changeUiScale(delta: number): void {
+    setUiScale(current + delta);
+}
+
+export function onUiScaleChange(fn: (scale: number) => void): void {
+    listeners.push(fn);
+    fn(current);
+}
+
+// 尽早应用一次：模块在 body 末尾以 module 方式加载，此时 head 已存在
+applyUiScale();
