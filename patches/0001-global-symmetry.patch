diff --git a/src/app/script/klecks/brushes/symmetry-brush.ts b/src/app/script/klecks/brushes/symmetry-brush.ts
new file mode 100644
index 0000000..7a4302c
--- /dev/null
+++ b/src/app/script/klecks/brushes/symmetry-brush.ts
@@ -0,0 +1,257 @@
+/**
+ * 全局对称绘制 —— 本项目补丁（P1），不是上游原始功能。
+ *
+ * 三种模式，按笔刷特性选择（见下方 BRUSH_MODE）：
+ *
+ *  - 'live'       每收到一步就同时驱动镜像笔刷。最快、有实时镜像预览。
+ *                 适合"每步只往画布上叠像素、不整层重合成"的笔刷（铅笔/素描/像素/橡皮）。
+ *
+ *  - 'sequential' 落笔期间只记录轨迹，抬笔后再把整条镜像笔画一次性喂给镜像笔刷。
+ *                 适合"复制整层 + 每帧重合成"的笔刷（水彩 blend、晕染 smudge）：
+ *                  这两个笔刷各自持有 layer 的副本并不停把合成结果写回，
+ *                  两个实例同时落笔会互相覆盖 → 交界处闪烁。串行执行就不会。
+ *
+ *  - 'native'     不建镜像实例，改为驱动该笔刷自带的对称功能
+ *                 （异形图形 ChemyBrush 自带 setXSymmetry/setYSymmetry，
+ *                  它用 canvas 变换镜像自己的一次渲染，交给它自己做最干净）。
+ *
+ * 取舍（已知）：live/sequential 模式下镜像笔刷会往同一份 KlHistory 推自己的条目，
+ * 所以一次对称笔画需要撤销两次才能完全撤销。native 模式没有这个问题（还是同一笔）。
+ */
+import { TPressureInput } from '../kl-types';
+
+type TAnyBrush = Record<string, any>;
+type TFactory<T> = () => T;
+export type TSymmetryMode = 'live' | 'sequential' | 'native';
+
+// 落笔方法：这些不被记录/重放，而是被镜像驱动
+const DRAW_METHODS = new Set(['startLine', 'goLine', 'endLine', 'drawLineSegment', 'drawImage']);
+
+/** 全局对称开关（模块级单例，由设置面板改写，落笔时读取） */
+export const symmetryState = {
+    horizontal: false, // 左右镜像（绕竖直中轴）
+    vertical: false, // 上下镜像（绕水平中轴）
+};
+
+export function setSymmetryHorizontal(b: boolean): void {
+    symmetryState.horizontal = b;
+}
+
+export function setSymmetryVertical(b: boolean): void {
+    symmetryState.vertical = b;
+}
+
+export function getSymmetryHorizontal(): boolean {
+    return symmetryState.horizontal;
+}
+
+export function getSymmetryVertical(): boolean {
+    return symmetryState.vertical;
+}
+
+export function isSymmetryEnabled(): boolean {
+    return symmetryState.horizontal || symmetryState.vertical;
+}
+
+type TMirrorKey = 'mh' | 'mv' | 'mhv';
+
+export function createSymmetryBrush<T extends TAnyBrush>(
+    brush: T,
+    factory: TFactory<T>,
+    opts: { mode?: TSymmetryMode } = {},
+): T {
+    const mode: TSymmetryMode = opts.mode || 'live';
+    let width = 0;
+    let height = 0;
+    const callLog: [string, any[]][] = [];
+    const mirrors: Partial<Record<TMirrorKey, T>> = {};
+
+    // sequential 模式的缓冲
+    let pendingStart: [number, number, number] | null = null;
+    let pendingPoints: TPressureInput[] = [];
+
+    const replay = (target: T): void => {
+        for (const [name, args] of callLog) {
+            try {
+                target[name](...args);
+            } catch {
+                /* 单个设置失败不该拖垮落笔 */
+            }
+        }
+    };
+
+    const mirror = (key: TMirrorKey): T => {
+        let m = mirrors[key];
+        if (!m) {
+            m = factory();
+            replay(m);
+            mirrors[key] = m;
+        }
+        return m;
+    };
+
+    const activeMirrors = (): { key: TMirrorKey; flipX: boolean; flipY: boolean }[] => {
+        const arr: { key: TMirrorKey; flipX: boolean; flipY: boolean }[] = [];
+        if (symmetryState.horizontal) arr.push({ key: 'mh', flipX: true, flipY: false });
+        if (symmetryState.vertical) arr.push({ key: 'mv', flipX: false, flipY: true });
+        if (symmetryState.horizontal && symmetryState.vertical) {
+            arr.push({ key: 'mhv', flipX: true, flipY: true });
+        }
+        return arr;
+    };
+
+    const mapX = (x: number, flipX: boolean): number => (flipX && width > 0 ? width - 1 - x : x);
+    const mapY = (y: number, flipY: boolean): number => (flipY && height > 0 ? height - 1 - y : y);
+    const mirrorPoint = (p: TPressureInput, flipX: boolean, flipY: boolean): TPressureInput => ({
+        ...p,
+        x: mapX(p.x, flipX),
+        y: mapY(p.y, flipY),
+    });
+
+    // native：把全局开关合并进笔刷自己的对称设置。
+    // 注意两个坑（都踩过）：
+    //  1) 关掉全局时也必须写回 false，否则笔刷内部的标记会一直是 true → "关了关不掉"；
+    //  2) 但笔刷自己也有一套对称勾选（如化学笔刷），不能直接覆盖 → 用 local || global 合并，
+    //     靠"当前值是否等于我们上次写入的值"来判断用户有没有动过它自己的开关。
+    let localX: boolean | null = null;
+    let localY: boolean | null = null;
+    let appliedX: boolean | null = null;
+    let appliedY: boolean | null = null;
+    const applyNative = (target: T): void => {
+        const hasX = typeof target.getXSymmetry === 'function' && typeof target.setXSymmetry === 'function';
+        const hasY = typeof target.getYSymmetry === 'function' && typeof target.setYSymmetry === 'function';
+        if (!hasX && !hasY) return;
+        try {
+            if (hasX) {
+                const cur = !!target.getXSymmetry();
+                if (localX === null || (appliedX !== null && cur !== appliedX)) localX = cur;
+                const eff = localX || symmetryState.horizontal;
+                target.setXSymmetry(eff);
+                appliedX = eff;
+            }
+            if (hasY) {
+                const cur = !!target.getYSymmetry();
+                if (localY === null || (appliedY !== null && cur !== appliedY)) localY = cur;
+                const eff = localY || symmetryState.vertical;
+                target.setYSymmetry(eff);
+                appliedY = eff;
+            }
+        } catch {
+            /* ignore */
+        }
+    };
+
+    return new Proxy(brush, {
+        get(target, prop, receiver) {
+            const name = prop as string;
+            const value = Reflect.get(target, prop, receiver);
+            if (typeof value !== 'function') {
+                return value;
+            }
+            return (...args: any[]) => {
+                // ---- 设置类：记录 + 同步给已存在的镜像 + 转发给原笔刷 ----
+                // 只记录 set*（写入类）。get* 之类的读调用若也记进日志，长期会话会越滚越大，
+                // 而且创建镜像时要把整个日志重放一遍。
+                if (!DRAW_METHODS.has(name)) {
+                    if (name.startsWith('set')) {
+                        callLog.push([name, args]);
+                        if (callLog.length > 256) callLog.shift();
+                    }
+                    if (name === 'setContext' && args[0] && args[0].canvas) {
+                        width = args[0].canvas.width;
+                        height = args[0].canvas.height;
+                    }
+                    if (isSymmetryEnabled()) {
+                        for (const key of Object.keys(mirrors) as TMirrorKey[]) {
+                            try {
+                                mirrors[key]![name](...args);
+                            } catch {
+                                /* ignore */
+                            }
+                        }
+                    }
+                    return value.apply(target, args);
+                }
+
+                // ---- native 模式：只驱动笔刷自带的对称 ----
+                if (mode === 'native') {
+                    if (name === 'startLine' || name === 'drawLineSegment') applyNative(target);
+                    return value.apply(target, args);
+                }
+
+                const result = value.apply(target, args);
+                const usable = isSymmetryEnabled() && width > 0 && height > 0;
+                if (!usable) return result;
+
+                try {
+                    if (mode === 'live') {
+                        if (name === 'startLine') {
+                            const [x, y, p] = args as [number, number, number];
+                            for (const m of activeMirrors()) {
+                                mirror(m.key).startLine(mapX(x, m.flipX), mapY(y, m.flipY), p);
+                            }
+                        } else if (name === 'goLine') {
+                            const points = args[0] as TPressureInput[];
+                            for (const m of activeMirrors()) {
+                                mirror(m.key).goLine(points.map((pt) => mirrorPoint(pt, m.flipX, m.flipY)));
+                            }
+                        } else if (name === 'endLine') {
+                            for (const m of activeMirrors()) mirror(m.key).endLine();
+                        } else if (name === 'drawLineSegment') {
+                            const [x1, y1, x2, y2] = args as [number, number, number, number];
+                            for (const m of activeMirrors()) {
+                                mirror(m.key).drawLineSegment(
+                                    mapX(x1, m.flipX),
+                                    mapY(y1, m.flipY),
+                                    mapX(x2, m.flipX),
+                                    mapY(y2, m.flipY),
+                                );
+                            }
+                        } else if (name === 'drawImage') {
+                            const [im, x, y] = args as [any, number, number];
+                            for (const m of activeMirrors()) {
+                                mirror(m.key).drawImage(im, mapX(x, m.flipX), mapY(y, m.flipY));
+                            }
+                        }
+                    } else if (mode === 'sequential') {
+                        // 落笔期间只记录，抬笔后再一次性喂给镜像笔刷
+                        if (name === 'startLine') {
+                            pendingStart = args as [number, number, number];
+                            pendingPoints = [];
+                        } else if (name === 'goLine') {
+                            pendingPoints.push(...(args[0] as TPressureInput[]));
+                        } else if (name === 'endLine') {
+                            if (pendingStart) {
+                                const [sx, sy, sp] = pendingStart;
+                                const pts = pendingPoints;
+                                for (const m of activeMirrors()) {
+                                    const mb = mirror(m.key);
+                                    mb.startLine(mapX(sx, m.flipX), mapY(sy, m.flipY), sp);
+                                    if (pts.length) {
+                                        mb.goLine(pts.map((pt) => mirrorPoint(pt, m.flipX, m.flipY)));
+                                    }
+                                    mb.endLine();
+                                }
+                            }
+                            pendingStart = null;
+                            pendingPoints = [];
+                        } else if (name === 'drawLineSegment') {
+                            const [x1, y1, x2, y2] = args as [number, number, number, number];
+                            for (const m of activeMirrors()) {
+                                mirror(m.key).drawLineSegment(
+                                    mapX(x1, m.flipX),
+                                    mapY(y1, m.flipY),
+                                    mapX(x2, m.flipX),
+                                    mapY(y2, m.flipY),
+                                );
+                            }
+                        }
+                    }
+                } catch {
+                    /* 镜像失败不影响原笔刷 */
+                }
+                return result;
+            };
+        },
+    }) as T;
+}
