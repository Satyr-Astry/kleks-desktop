+/**
+ * 本项目补丁 P3（渲染优化）：算出「视口在 document 坐标里覆盖到的矩形」（四角逆变换后的外接盒 + 余量）。
+ * 用来只绘制看得见的部分，成本从「图层数 × 整张画布」降到「图层数 × 可见面积」。
+ * 缩小时 1 屏幕像素对应很多 document 像素，所以余量按缩放放大，避免边缘插值缺一两像素。
+ */
+function computeVisibleProjectRect(
+    renderedMat: Matrix,
+    viewportWidth: number,
+    viewportHeight: number,
+    projectWidth: number,
+    projectHeight: number,
+    renderedTransform: TViewportTransformXY,
+): { x: number; y: number; width: number; height: number } {
+    const inv = inverse(renderedMat);
+    const corners = [
+        { x: 0, y: 0 },
+        { x: viewportWidth, y: 0 },
+        { x: 0, y: viewportHeight },
+        { x: viewportWidth, y: viewportHeight },
+    ].map((p) => applyToPoint(inv, p));
+    const minX = Math.min(...corners.map((c) => c.x));
+    const maxX = Math.max(...corners.map((c) => c.x));
+    const minY = Math.min(...corners.map((c) => c.y));
+    const maxY = Math.max(...corners.map((c) => c.y));
+    const minScale = Math.max(
+        1e-6,
+        Math.min(Math.abs(renderedTransform.scaleX), Math.abs(renderedTransform.scaleY)),
+    );
+    const margin = Math.ceil(4 / minScale) + 2;
+    const x = Math.max(0, Math.floor(minX - margin));
+    const y = Math.max(0, Math.floor(minY - margin));
+    const right = Math.min(projectWidth, Math.ceil(maxX + margin));
+    const bottom = Math.min(projectHeight, Math.ceil(maxY + margin));
+    return { x, y, width: Math.max(0, right - x), height: Math.max(0, bottom - y) };
+}
